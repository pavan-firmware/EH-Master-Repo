# =============================================================================
# EH HOME FLUTTER CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
#
# Usage options:
# 1. Compile-time command line flag:
#    flutter run --dart-define=BACKEND_BASE_URL=http://192.168.1.8:3000 --dart-define=APP_ENV=development
#
# 2. Config file (--dart-define-from-file):
#    flutter run --dart-define-from-file=.env.json
# =============================================================================

# Options: development | staging | production
APP_ENV=development

# Backend API Base URL
# Development with physical phone on LAN: http://<YOUR_LAN_IP>:3000 (e.g. http://192.168.1.8:3000)
# Android Emulator:                       http://10.0.2.2:3000
# iOS Simulator / Web:                    http://localhost:3000
# Staging:                                https://staging-api.eh-home.io
# Production:                             https://api.eh-home.io
BACKEND_BASE_URL=http://192.168.1.8:3000
