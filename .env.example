# =============================================================================
# EH HOME — MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to .env (gitignored) for local development or configure in your
# deployment secret manager (e.g. AWS Secrets Manager / GCP Secret Manager / Vault).
#
# NEVER commit real production secrets, passwords, private keys, or API tokens to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME
# -----------------------------------------------------------------------------
# Options: development | staging | production | test
NODE_ENV=development
APP_ENV=development
PORT=3000
HOST=0.0.0.0
# Public base URL of backend API (used by Flutter, mobile apps, and web clients)
# Development (physical phone on LAN): http://<HOST_LAN_IP>:3000 (e.g. http://192.168.1.8:3000)
# Development (emulator / simulator):  http://10.0.2.2:3000 or http://localhost:3000
# Staging / Production:                https://api.yourdomain.com
BACKEND_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 14+)
# -----------------------------------------------------------------------------
# Development default uses local postgres container or installation
DATABASE_URL=postgresql://eh_admin:eh_development_password_only@localhost:5432/eh_home_dev

# -----------------------------------------------------------------------------
# 3. CACHE & PUBSUB (Redis 7+)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# 4. MQTT 5 BROKER (EMQX 5.8.0)
# -----------------------------------------------------------------------------
# TCP Broker (local dev):  mqtt://localhost:1883
# TLS Broker (mTLS/Prod):  mqtts://localhost:8883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TLS_BROKER_URL=mqtts://localhost:8883
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_BACKEND_USERNAME=eh_backend_service
MQTT_BACKEND_PASSWORD=eh_backend_dev_secret

# Optional TLS certificate file paths for MQTT broker authentication:
MQTT_CA_FILE=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=

# -----------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY TOKENS
# -----------------------------------------------------------------------------
# Min 32 characters high-entropy string in production:
JWT_SECRET=eh_local_dev_jwt_secret_do_not_use_in_prod_1234567890
SESSION_SECRET=eh_local_dev_session_secret_do_not_use_in_prod_1234567890
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_ISSUER=eh-home-auth
AUTH_AUDIENCE=eh-home-app

# -----------------------------------------------------------------------------
# 6. S3 / OBJECT STORAGE (Firmware Releases & OTA Manifests)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=eh-firmware-releases
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# -----------------------------------------------------------------------------
# 7. DEVELOPMENT INITIAL ACCOUNT (Optional bootstrap seed)
# -----------------------------------------------------------------------------
DEV_USER_EMAIL=developer@eh-home.local
DEV_USER_PASSWORD=DeveloperPass123!

