# ==========================================================
# EH HOME ENVIRONMENT CONFIGURATION (TEMPLATE)
# NEVER commit production secrets or real API keys to Git.
# ==========================================================

NODE_ENV=development
PORT=3000
API_PORT=3100
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://eh_admin:eh_development_password_only@localhost:5432/eh_home_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eh_home_dev
DB_USER=eh_admin
DB_PASSWORD=eh_development_password_only
DB_SSL=false
DATABASE_POOL_MAX=20

# Cache & Message Queue (Redis)
REDIS_URL=redis://localhost:6379

# MQTT 5 Broker (EMQX)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TLS_BROKER_URL=mqtts://localhost:8883
MQTT_BACKEND_USERNAME=eh_backend_service
MQTT_BACKEND_PASSWORD=eh_backend_dev_secret

# Security & Sessions
JWT_SECRET=eh_local_dev_jwt_secret_do_not_use_in_prod_1234567890
SESSION_SECRET=eh_local_dev_session_secret_do_not_use_in_prod_1234567890

# Free local persistent object storage for desktop/API installations.
STORAGE_PROVIDER=disk # 'disk' for local production, 'memory' only for tests, 'minio' or 's3' for shared deployments
STORAGE_ROOT=./data/storage
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# S3 / MinIO Object Storage (optional shared deployment)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Database Backup & Retention (Part 16)
BACKUP_RETENTION_MAX_COUNT=30
BACKUP_RETENTION_DAYS=30
