[Unit]
Description=EH Home Smart Hub Core Engine
After=network.target
Wants=network.target

[Service]
Type=simple
User=ehpavan
WorkingDirectory=/home/ehpavan/eh-hub
ExecStartPre=+/bin/sh -c 'chmod 666 /sys/class/leds/ACT/trigger /sys/class/leds/ACT/brightness /sys/class/leds/led0/trigger /sys/class/leds/led0/brightness 2>/dev/null || true'
ExecStart=/usr/bin/node /home/ehpavan/eh-hub/src/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=HUB_PORT=4210
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

