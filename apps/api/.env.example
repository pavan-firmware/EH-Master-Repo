# EH Home API Environment Template
# Copy to .env and configure for your local environment.
# DO NOT COMMIT PRODUCTION CREDENTIALS.

NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://eh_user:your_secure_password@localhost:5432/eh_home

# Alternative discrete DB parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eh_home
DB_USER=eh_user
DB_PASSWORD=your_secure_password
DB_SSL=false
DATABASE_POOL_MAX=20

# CORS & Security
CORS_ORIGIN=*
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT_BYTES=1048576
