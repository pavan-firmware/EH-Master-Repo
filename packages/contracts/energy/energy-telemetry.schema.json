{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/energy/energy-telemetry.schema.json",
  "title": "EnergyTelemetry",
  "description": "Deterministic integer fixed-point electrical measurements from device hardware metering IC.",
  "type": "object",
  "required": [
    "schemaVersion",
    "deviceId",
    "channelIndex",
    "v_mv",
    "i_ma",
    "p_mw",
    "e_tot_wh",
    "e_int_mwh",
    "freq_mhz",
    "pf_x1000",
    "flags",
    "timestamp",
    "sequenceNumber"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "channelIndex": {
      "type": "integer",
      "minimum": 1
    },
    "v_mv": {
      "type": "integer",
      "minimum": 0,
      "description": "RMS Voltage in Millivolts (1 V = 1000 mV)"
    },
    "i_ma": {
      "type": "integer",
      "minimum": 0,
      "description": "RMS Current in Milliamperes (1 A = 1000 mA)"
    },
    "p_mw": {
      "type": "integer",
      "minimum": 0,
      "description": "Active Power in Milliwatts (1 W = 1000 mW)"
    },
    "e_tot_wh": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic cumulative total energy in Watt-hours (Wh, uint64)"
    },
    "e_int_mwh": {
      "type": "integer",
      "minimum": 0,
      "description": "Interval delta energy in Milliwatt-hours (mWh, 1 Wh = 1000 mWh)"
    },
    "freq_mhz": {
      "type": "integer",
      "minimum": 0,
      "description": "AC Line Frequency in Millihertz (50 Hz = 50000 mHz)"
    },
    "pf_x1000": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "Power Factor scaled by 1000 (0 to 1000)"
    },
    "flags": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "Bitfield: Bit 0 = COUNTER_RESET, Bit 1 = HARDWARE_FAULT"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sequenceNumber": {
      "type": "integer",
      "minimum": 0
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "deviceId": "0194fe23-7a1b-7890-a123-456789abcdef",
      "channelIndex": 1,
      "v_mv": 230450,
      "i_ma": 812,
      "p_mw": 187120,
      "e_tot_wh": 142508,
      "e_int_mwh": 259800,
      "freq_mhz": 50010,
      "pf_x1000": 980,
      "flags": 0,
      "timestamp": "2026-03-01T12:00:00Z",
      "sequenceNumber": 48102
    }
  ]
}
