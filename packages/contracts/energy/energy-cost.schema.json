{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/energy/energy-cost.schema.json",
  "title": "ElectricityTariff",
  "description": "Canonical contract schema for electricity tariffs, time-of-use periods, budgets, and cost forecasts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "homeId",
    "name",
    "tariffType",
    "currency",
    "effectiveFrom",
    "isActive"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string"
    },
    "homeId": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tariffType": {
      "type": "string",
      "enum": ["FLAT", "TIME_OF_USE", "DYNAMIC"]
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "flatRatePerKwh": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "fixedDailyCharge": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    },
    "effectiveTo": {
      "type": ["string", "null"]
    },
    "carbonIntensityGPerKwh": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "isActive": {
      "type": "boolean"
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "periodType", "startTime", "endTime", "applicableWeekdays", "pricePerKwh"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "periodType": {
            "type": "string",
            "enum": ["OFF_PEAK", "STANDARD", "PEAK", "CRITICAL_PEAK"]
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "applicableWeekdays": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 7 },
            "minItems": 1
          },
          "pricePerKwh": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "metadata": {
      "type": ["object", "null"]
    }
  }
}
