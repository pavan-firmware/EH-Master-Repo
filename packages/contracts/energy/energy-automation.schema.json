{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/energy/energy-automation.schema.json",
  "title": "EnergyAutomationRule",
  "description": "Rule definition for energy-triggered automations and hysteresis policies.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "homeId",
    "name",
    "isEnabled",
    "triggerCondition",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string"
    },
    "homeId": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "isEnabled": {
      "type": "boolean"
    },
    "scopeType": {
      "type": "string",
      "enum": ["device", "room", "home"]
    },
    "scopeId": {
      "type": ["string", "null"]
    },
    "triggerCondition": {
      "type": "object",
      "required": ["metric", "operator", "threshold"],
      "properties": {
        "metric": {
          "type": "string",
          "enum": ["instantaneous_power", "cumulative_energy", "daily_energy", "monthly_energy", "sustained_power"]
        },
        "operator": {
          "type": "string",
          "enum": ["GT", "GTE", "LT", "LTE", "EQ"]
        },
        "threshold": {
          "type": "number"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeWindow": {
          "type": "object",
          "properties": {
            "startTime": { "type": "string" },
            "endTime": { "type": "string" },
            "daysOfWeek": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 7 }
            }
          }
        }
      }
    },
    "hysteresis": {
      "type": "object",
      "properties": {
        "recoveryThreshold": { "type": "number" },
        "cooldownSeconds": { "type": "integer", "minimum": 0 },
        "minimumDurationSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["actionType"],
        "properties": {
          "actionType": { "type": "string", "enum": ["device_command", "scene_execution"] },
          "deviceId": { "type": "string" },
          "channelIndex": { "type": "integer" },
          "command": { "type": "string" },
          "params": { "type": "object" },
          "sceneId": { "type": "string" }
        }
      }
    },
    "cooldownSeconds": {
      "type": "integer",
      "minimum": 0
    }
  }
}
