{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/state/device-state.schema.json",
  "title": "DeviceState",
  "description": "Aggregate device state container mapping all channels and connection status.",
  "type": "object",
  "required": [
    "schemaVersion",
    "deviceId",
    "connectionState",
    "channels",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "connectionState": {
      "type": "string",
      "enum": ["ONLINE", "STALE", "OFFLINE"]
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.ehhome.io/state/channel-state.schema.json"
      }
    },
    "lastSeenAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "lastCommandId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "lastEventId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "deviceId": "0194fe23-7a1b-7890-a123-456789abcdef",
      "connectionState": "ONLINE",
      "channels": [
        {
          "schemaVersion": 1,
          "channelIndex": 1,
          "desiredState": { "power": true },
          "reportedState": { "power": true },
          "confidence": "CONFIRMED",
          "updatedAt": "2026-03-01T12:00:00Z"
        },
        {
          "schemaVersion": 1,
          "channelIndex": 2,
          "desiredState": { "power": false },
          "reportedState": { "power": false },
          "confidence": "CONFIRMED",
          "updatedAt": "2026-03-01T12:00:00Z"
        },
        {
          "schemaVersion": 1,
          "channelIndex": 3,
          "desiredState": { "power": true },
          "reportedState": { "power": true },
          "confidence": "CONFIRMED",
          "updatedAt": "2026-03-01T12:00:00Z"
        }
      ],
      "lastSeenAt": "2026-03-01T12:00:00Z",
      "lastCommandId": null,
      "lastEventId": null,
      "updatedAt": "2026-03-01T12:00:00Z"
    }
  ]
}
