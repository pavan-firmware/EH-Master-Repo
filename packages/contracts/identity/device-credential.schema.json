{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/identity/device-credential.schema.json",
  "title": "DeviceCredential",
  "description": "Hardware authentication credentials, key hashes, and lifecycle state.",
  "type": "object",
  "required": [
    "schemaVersion",
    "deviceId",
    "mqttUsername",
    "mqttPasswordHash",
    "localSessionKeyHash",
    "credentialState",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "mqttUsername": {
      "type": "string",
      "minLength": 4
    },
    "mqttPasswordHash": {
      "type": "string",
      "description": "Argon2id/bcrypt hash of per-device MQTT token"
    },
    "tlsClientCertFingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "localSessionKeyHash": {
      "type": "string",
      "description": "Hash of 256-bit factory local key used for Direct LAN HMAC"
    },
    "credentialState": {
      "type": "string",
      "enum": [
        "FACTORY",
        "PROVISIONED",
        "CLAIMED",
        "ACTIVE",
        "ROTATED",
        "REVOKED",
        "RESET"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "rotatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "deviceId": "0194fe23-7a1b-7890-a123-456789abcdef",
      "mqttUsername": "eh_dev_0194fe237a1b7890",
      "mqttPasswordHash": "$argon2id$v=19$m=65536,t=3,p=4$dummyhash...",
      "tlsClientCertFingerprint": null,
      "localSessionKeyHash": "sha256_dummy_hash_for_factory_key",
      "credentialState": "ACTIVE",
      "createdAt": "2026-03-01T08:00:00Z",
      "rotatedAt": null
    }
  ]
}
