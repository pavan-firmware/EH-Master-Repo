{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/device-trust/device-credential-lifecycle.schema.json",
  "title": "DeviceCredentialLifecycle",
  "description": "Historical rotation, key identity, and lifecycle ledger for device credentials. Strictly non-secret metadata.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "deviceId",
    "credentialType",
    "keyIdentifier",
    "status",
    "rotationGeneration",
    "issuedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Schema format version"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of the lifecycle record"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid",
      "description": "Canonical immutable logical UUID of the device"
    },
    "credentialType": {
      "type": "string",
      "enum": [
        "MQTT",
        "DIRECT_LAN",
        "TLS_CERT",
        "MATTER_NOC"
      ],
      "description": "Category of device communication credential"
    },
    "keyIdentifier": {
      "type": "string",
      "minLength": 3,
      "description": "Public or non-sensitive key identifier/label"
    },
    "fingerprint": {
      "type": ["string", "null"],
      "description": "Cryptographic hash or public fingerprint of credential"
    },
    "status": {
      "type": "string",
      "enum": [
        "ROTATION_PENDING",
        "CONFIRMED",
        "ROTATED",
        "REVOKED",
        "EXPIRED"
      ],
      "description": "Lifecycle generation status"
    },
    "rotationGeneration": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing rotation generation counter for device + type"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this generation was issued or initiated"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Expiration timestamp if applicable"
    },
    "rotatedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp when replaced by a newer generation"
    },
    "revokedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp when revoked, or null"
    },
    "metadata": {
      "type": "object",
      "description": "Strictly non-sensitive operational metadata. MUST NOT contain plaintext passwords, private keys, or tokens."
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "id": "e0000000-0000-0000-0000-000000000001",
      "deviceId": "0194fe23-7a1b-7890-a123-456789abcdef",
      "credentialType": "MQTT",
      "keyIdentifier": "eh_dev_0194fe237a1b7890_gen2",
      "fingerprint": "a1b2c3d4e5f6071829304a5b6c7d8e9f0123456789abcdef0123456789abcdef",
      "status": "CONFIRMED",
      "rotationGeneration": 2,
      "issuedAt": "2026-09-04T16:00:00.000Z",
      "expiresAt": null,
      "rotatedAt": null,
      "revokedAt": null,
      "metadata": {
        "algorithm": "Argon2id",
        "provider": "EH_INTERNAL",
        "rotationReason": "PERIODIC_POLICY"
      }
    }
  ]
}
