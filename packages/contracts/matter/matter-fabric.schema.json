{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/matter/matter-fabric.schema.json",
  "title": "MatterFabric",
  "description": "Matter multi-admin fabric binding instance linking a device to an ecosystem controller (Apple Home, Google Home, Alexa, or EH Controller).",
  "type": "object",
  "required": [
    "schemaVersion",
    "fabricId",
    "matterDeviceId",
    "fabricIndex",
    "fabricName",
    "vendorId",
    "commissioningState"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "fabricId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{16}$"
    },
    "matterDeviceId": {
      "type": "string",
      "minLength": 3
    },
    "fabricIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 254
    },
    "fabricName": {
      "type": "string",
      "enum": ["APPLE_HOME", "GOOGLE_HOME", "AMAZON_ALEXA", "EH_HOME", "CUSTOM_CONTROLLER"]
    },
    "vendorId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "controllerNodeId": {
      "type": ["string", "null"],
      "pattern": "^0x[0-9a-fA-F]{16}$"
    },
    "commissioningState": {
      "type": "string",
      "enum": [
        "NOT_COMMISSIONED",
        "COMMISSIONING",
        "COMMISSIONED",
        "PARTIALLY_CONNECTED",
        "CONNECTED",
        "DISCONNECTED",
        "DECOMMISSIONED"
      ]
    },
    "label": {
      "type": ["string", "null"]
    },
    "pairedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "lastSynchronizedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
