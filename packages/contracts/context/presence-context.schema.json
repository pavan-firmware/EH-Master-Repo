{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PresenceAndContextIntelligenceSchema",
  "description": "EH Home canonical schema definitions for Presence, Context Intelligence and Context-Aware Automations",
  "definitions": {
    "PresenceSource": {
      "type": "string",
      "enum": ["mobile_app", "manual", "lan_wifi", "ble", "device_activity", "sensor"]
    },
    "PresenceState": {
      "type": "string",
      "enum": ["HOME", "AWAY", "UNKNOWN", "SLEEP"]
    },
    "ContextMode": {
      "type": "string",
      "enum": ["HOME", "AWAY", "SLEEP", "VACATION", "GUEST", "QUIET_HOURS"]
    },
    "PresenceSignal": {
      "type": "object",
      "required": ["userId", "homeId", "source", "state", "confidence", "observedAt"],
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "minLength": 1 },
        "homeId": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/definitions/PresenceSource" },
        "state": { "$ref": "#/definitions/PresenceState" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "evidence": { "type": "object" }
      },
      "additionalProperties": false
    },
    "PresenceSnapshot": {
      "type": "object",
      "required": ["homeId", "state", "confidence", "isOccupied", "activeUserCount", "calculatedAt"],
      "properties": {
        "homeId": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/definitions/PresenceState" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "isOccupied": { "type": "boolean" },
        "activeUserCount": { "type": "integer", "minimum": 0 },
        "userStates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "state": { "$ref": "#/definitions/PresenceState" },
              "confidence": { "type": "number" },
              "source": { "type": "string" },
              "observedAt": { "type": "string" },
              "isStale": { "type": "boolean" }
            }
          }
        },
        "inferredRooms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["roomId", "isOccupied", "confidence", "isInferred"],
            "properties": {
              "roomId": { "type": "string" },
              "isOccupied": { "type": "boolean" },
              "confidence": { "type": "number" },
              "isInferred": { "type": "boolean" },
              "inferenceReason": { "type": "string" },
              "lastActivityAt": { "type": "string" }
            }
          }
        },
        "calculatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "PresenceOverride": {
      "type": "object",
      "required": ["id", "homeId", "userId", "mode", "createdAt", "isActive"],
      "properties": {
        "id": { "type": "string" },
        "homeId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/definitions/ContextMode" },
        "state": { "$ref": "#/definitions/PresenceState" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "HomeContext": {
      "type": "object",
      "required": ["homeId", "mode", "precedenceTier", "isVacation", "isOccupied", "confidence", "updatedAt"],
      "properties": {
        "homeId": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/definitions/ContextMode" },
        "previousMode": { "type": ["string", "null"] },
        "precedenceTier": {
          "type": "string",
          "enum": ["MANUAL_OVERRIDE", "SCHEDULED_WINDOW", "RECONCILED_PRESENCE", "DEFAULT_FALLBACK"]
        },
        "activeOverride": {
          "type": ["object", "null"],
          "properties": {
            "id": { "type": "string" },
            "userId": { "type": "string" },
            "mode": { "type": "string" },
            "reason": { "type": "string" },
            "expiresAt": { "type": ["string", "null"] }
          }
        },
        "isVacation": { "type": "boolean" },
        "isOccupied": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ContextTransition": {
      "type": "object",
      "required": ["id", "homeId", "fromMode", "toMode", "triggerSource", "timestamp"],
      "properties": {
        "id": { "type": "string" },
        "homeId": { "type": "string", "minLength": 1 },
        "fromMode": { "type": "string" },
        "toMode": { "$ref": "#/definitions/ContextMode" },
        "triggerSource": { "type": "string" },
        "reason": { "type": "string" },
        "evidence": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "signal": { "$ref": "#/definitions/PresenceSignal" },
    "snapshot": { "$ref": "#/definitions/PresenceSnapshot" },
    "override": { "$ref": "#/definitions/PresenceOverride" },
    "context": { "$ref": "#/definitions/HomeContext" },
    "transition": { "$ref": "#/definitions/ContextTransition" }
  }
}
