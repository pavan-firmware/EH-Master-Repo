{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/notification/notification-preference.schema.json",
  "title": "NotificationPreference",
  "description": "User notification preferences including category toggles, delivery channels, and quiet hours configuration.",
  "type": "object",
  "required": [
    "schemaVersion",
    "userId",
    "pushEnabled",
    "criticalAlerts",
    "deviceOffline",
    "automationFailure",
    "firmwareUpdates",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "pushEnabled": {
      "type": "boolean"
    },
    "emailEnabled": {
      "type": "boolean"
    },
    "inAppEnabled": {
      "type": "boolean"
    },
    "criticalAlerts": {
      "type": "boolean"
    },
    "deviceOffline": {
      "type": "boolean"
    },
    "deviceHealth": {
      "type": "boolean"
    },
    "automationFailure": {
      "type": "boolean"
    },
    "firmwareUpdates": {
      "type": "boolean"
    },
    "energyAlerts": {
      "type": "boolean"
    },
    "securityAlerts": {
      "type": "boolean"
    },
    "matterAlerts": {
      "type": "boolean"
    },
    "memberAlerts": {
      "type": "boolean"
    },
    "quietHoursEnabled": {
      "type": "boolean"
    },
    "quietHoursStart": {
      "type": "string",
      "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
    },
    "quietHoursEnd": {
      "type": "string",
      "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
