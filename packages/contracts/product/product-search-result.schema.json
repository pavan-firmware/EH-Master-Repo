{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/product/product-search-result.schema.json",
  "title": "ProductSearchResult",
  "description": "Deterministic product search output with matched fields and scores.",
  "type": "object",
  "required": ["query", "results", "total"],
  "additionalProperties": false,
  "properties": {
    "query": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product", "matchedFields", "relevanceScore"],
        "properties": {
          "product": { "$ref": "https://contracts.ehhome.io/product/product-catalog-entry.schema.json" },
          "matchedFields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "relevanceScore": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "total": { "type": "integer", "minimum": 0 }
  }
}
