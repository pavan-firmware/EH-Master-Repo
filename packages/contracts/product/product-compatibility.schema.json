{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/product/product-compatibility.schema.json",
  "title": "ProductCompatibility",
  "description": "Deterministic structured compatibility output for a product in a home environment.",
  "type": "object",
  "required": [
    "status",
    "isCompatible",
    "reasons",
    "supportedTransports",
    "recommendedCommissioningTransport",
    "unsupportedFeatures",
    "evaluatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["COMPATIBLE", "PARTIALLY_COMPATIBLE", "INCOMPATIBLE"]
    },
    "isCompatible": { "type": "boolean" },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["INFO", "WARNING", "BLOCKING"]
          },
          "remedy": { "type": ["string", "null"] }
        }
      }
    },
    "supportedTransports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendedCommissioningTransport": { "type": "string" },
    "unsupportedFeatures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evaluatedAt": { "type": "string" }
  }
}
