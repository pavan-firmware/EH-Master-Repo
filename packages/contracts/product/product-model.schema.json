{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/product/product-model.schema.json",
  "title": "ProductModelDef",
  "description": "Canonical definition of a product hardware model within a product family.",
  "type": "object",
  "required": ["modelId", "familyId", "marketingName", "technicalName", "description"],
  "additionalProperties": false,
  "properties": {
    "modelId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "familyId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "marketingName": {
      "type": "string",
      "minLength": 1
    },
    "technicalName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "brand": {
      "type": "string"
    }
  }
}
