{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.ehhome.io/ota/ota-manifest.schema.json",
  "title": "OTAManifest",
  "description": "Cryptographically signed firmware release manifest with integrity and authenticity hashes.",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseId",
    "productVariantId",
    "hardwareRevision",
    "version",
    "minFirmwareVersion",
    "binarySizeBytes",
    "sha256",
    "ed25519Signature",
    "downloadUrl",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "releaseId": {
      "type": "string",
      "format": "uuid"
    },
    "productVariantId": {
      "type": "string",
      "pattern": "^eh-[a-z0-9-]+$"
    },
    "hardwareRevision": {
      "type": "string",
      "pattern": "^HW_[0-9]+_[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "minFirmwareVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "binarySizeBytes": {
      "type": "integer",
      "minimum": 1024
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "SHA-256 integrity hash"
    },
    "ed25519Signature": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{128}$",
      "description": "Ed25519 authenticity signature generated by EH Release Key"
    },
    "downloadUrl": {
      "type": "string",
      "format": "uri"
    },
    "releaseNotes": {
      "type": ["string", "null"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "releaseId": "0194fe23-7a1b-7890-a123-456789444444",
      "productVariantId": "eh-smart-switch-3x",
      "hardwareRevision": "HW_1_0",
      "version": "1.2.0",
      "minFirmwareVersion": "1.0.0",
      "binarySizeBytes": 1572864,
      "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "ed25519Signature": "11223344556677889900aabbccddeeff11223344556677889900aabbccddeeff11223344556677889900aabbccddeeff11223344556677889900aabbccddeeff",
      "downloadUrl": "https://ota.ehhome.io/firmware/eh-switch-3x-v1.2.0.bin",
      "releaseNotes": "Fix zero-cross timing on capacitive loads",
      "createdAt": "2026-03-01T12:00:00Z"
    }
  ]
}
