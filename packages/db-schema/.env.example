# EH Home Database Configuration Template
# Copy to .env and adjust values for your environment.
# DO NOT COMMIT PRODUCTION SECRETS.

# Preferred: Connection URI format
DATABASE_URL=postgresql://eh_user:your_secure_password@localhost:5432/eh_home

# Alternative: Discrete connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eh_home
DB_USER=eh_user
DB_PASSWORD=your_secure_password
DB_SSL=false

# Pool sizing and timeout settings
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
